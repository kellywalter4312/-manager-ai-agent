# Example environment configuration.
#
# Copy to .env for your own notes, or set these variables in your shell.
# .env is gitignored; this file is committed and must never contain real values.
#
# Nothing here is required. With no variables set at all, the application runs
# on its defaults: console logging at INFO and the null provider.

# Logging verbosity: CRITICAL | ERROR | WARNING | INFO | DEBUG
# DEBUG shows every phase of the DATA loop.
MANAGER_LOG_LEVEL=INFO

# Which language-model backend to use.
#   null      : the default; needs no key, no network and no model
#   anthropic : Claude via the official Anthropic SDK (requires an API key)
#   openai    : OpenAI via the official openai SDK (requires an API key)
#   xai       : xAI's Grok, via the same openai SDK pointed at xAI's own
#               endpoint (requires an API key) - see
#               src/providers/xai_provider.py for why one SDK serves both
MANAGER_PROVIDER=null

# Model identifiers - each provider owns its own field, never a shared one,
# so switching providers never means guessing which vendor a bare "model"
# setting was meant for. Only the field matching MANAGER_PROVIDER above is
# ever read.
MANAGER_MODEL=claude-opus-5
MANAGER_OPENAI_MODEL=gpt-5
MANAGER_XAI_MODEL=grok-4

# API key for the anthropic provider specifically. LEAVE EMPTY HERE - this
# file is committed. Put the real value in .env (gitignored) or export it in
# your shell. If unset, the Anthropic SDK falls back to its own
# ANTHROPIC_API_KEY lookup, so either MANAGER_API_KEY or ANTHROPIC_API_KEY
# will work. This field is anthropic-specific and is never read by any other
# provider (see src/providers/factory.py) - openai and xai each read their
# own variable below instead, exactly the way ELEVENLABS_API_KEY already
# does for the elevenlabs speech provider further down this file.
MANAGER_API_KEY=

# API key for the openai provider. Read directly from this variable, the
# same way the anthropic SDK falls back to ANTHROPIC_API_KEY - there is no
# MANAGER_-prefixed equivalent, because it is a distinct secret for a
# distinct provider account, never interchangeable with MANAGER_API_KEY.
OPENAI_API_KEY=

# API key for the xai provider - xAI's own account, never OpenAI's, even
# though both happen to speak through the same SDK package.
XAI_API_KEY=

# Which speech engine hears and speaks for this installation.
#   none       : the default; no engine, listen()/speak() report that honestly
#   windows    : local System.Speech via PowerShell - no key, no network
#   elevenlabs : cloud text-to-speech via the official ElevenLabs SDK
#                (requires ELEVENLABS_API_KEY below; text-to-speech only)
MANAGER_SPEECH=none

# API key for the elevenlabs speech provider. LEAVE EMPTY HERE - this file is
# committed. Put the real value in .env (gitignored) or export it in your
# shell. Read directly from this variable, the same way MANAGER_PROVIDER=
# anthropic falls back to ANTHROPIC_API_KEY - there is no MANAGER_-prefixed
# equivalent for this vendor, because it is a distinct secret for a distinct
# provider, not the same key as MANAGER_API_KEY above.
ELEVENLABS_API_KEY=

# Where Alfred's live-information tool reaches for current, external
# evidence - never a subject or a search topic, just which real source
# answers a query.
#   null      : the default; no real source, honestly empty results
#   wikipedia : Wikipedia's own public search API - no key, no signup,
#               no network dependency beyond a single read-only endpoint
MANAGER_LIVE_INFO_PROVIDER=null

# Which real narration/image/video backend the media_production tool is
# built from.
#   null     : the default; no engine, media_production reports so honestly
#   local    : genuine local production, no key and no network, ever -
#              Kokoro narration (reusing the same engine
#              MANAGER_SPEECH=kokoro uses), a local title-card image
#              renderer, and FFmpeg composition (see src/providers/media/)
#   ai_image : genuine AI image generation via pollinations.ai - free,
#              keyless, no signup - alongside the same local Kokoro
#              narration and FFmpeg composition "local" already uses.
#              Reaches a real, external, third-party service over the
#              network; "local" remains available if you want zero
#              network calls of any kind.
MANAGER_MEDIA=null

# Where media_production writes real, produced narration/image/video
# assets. Change this if data/media/assets is not where you want them.
MANAGER_MEDIA_ASSET_DIR=data/media/assets

# Where Alfred's knowledge tool reaches for the documents, books and notes
# *you* supplied - a separate axis from live information above, because
# "what the world looks like now" and "what this person actually gave me"
# are different kinds of knowing and neither may stand in for the other.
#   documents : the default; reads plain-text/markdown files out of
#               MANAGER_KNOWLEDGE_DIR. No key, no signup, no network. An
#               absent or empty folder answers exactly as "null" does, so
#               the default claims nothing until you put something in it.
#   null      : no user-supplied knowledge at all, honestly empty
MANAGER_KNOWLEDGE_PROVIDER=documents

# The folder those documents live in. Put anything you want Alfred to be
# able to quote in here - a history book, a biography, a motivational or
# business book, lecture notes, a syllabus, a transcript. Nothing in this
# project knows or cares what is in it: a document is text with a name on
# it, and no subject is ever built into the software.
MANAGER_KNOWLEDGE_DIR=data/knowledge

# Where Alfred's governed communication tools reach for a real phone/
# messaging connection - never a contact list, just which authorized
# connection performs a read/send/call.
#   null : the only shipped option; no authorized connection, honestly
#          unavailable for send/call, honestly empty for read
MANAGER_COMMUNICATION_PROVIDER=null

# Where a genuine milestone celebration's presentation reaction comes
# from - never the words Alfred says, only the avatar/environment/overlay
# instructions a future presentation layer could render.
#   default : the only shipped option, and a genuinely working one (not
#             an empty placeholder) - see
#             src/providers/default_celebration_provider.py
MANAGER_CELEBRATION_PROVIDER=default

# Where Alfred's governed connection tools reach for a real external,
# authenticated service - never a giant integration framework, just
# which authorized connection a governed action is actually attempted
# through.
#   null  : the default; no connection configured, honestly unavailable
#   gmail : reuses the existing Gmail read boundary (see
#           src/providers/gmail_connection.py) - read-only, the same
#           safeguard this project's Gmail integration has always had
MANAGER_CONNECTION_PROVIDER=null

# How tasks are routed to agents.
#   capability : match the task's words against each agent's declared
#                capabilities (the default; no model involved)
#   llm        : ask the configured provider to choose, falling back to
#                capability matching whenever the model declines or fails
# With MANAGER_PROVIDER=null the llm option always falls back, so routing
# behaviour is identical until a real provider exists.
MANAGER_ROUTER=capability

# Where the EmailAgent reads mail from.
#   memory : the built-in sample inbox; no credentials, no network (default)
#   gmail  : your real Gmail account, READ-ONLY
# Selecting "gmail" requires a one-time authorization:
#   1. Create a Google Cloud project and enable the Gmail API
#   2. Create an OAuth client ID (Application type: "Desktop app")
#   3. Save the downloaded JSON as data/credentials.json
#   4. pip install google-api-python-client google-auth-oauthlib
#   5. python scripts/authorize_gmail.py
MANAGER_MAILBOX=memory

# Where the Gmail credential files live. These are PATHS, never secrets.
# Both default under data/, which is gitignored. Never commit either file.
MANAGER_GMAIL_CREDENTIALS_PATH=data/credentials.json
MANAGER_GMAIL_TOKEN_PATH=data/token.json

# --- Heartbeat (autonomous monitoring) ------------------------------------
# Autonomy is opt-in. With this false the heartbeat performs no work and makes
# no Gmail request at all; scripts/heartbeat.py --once still allows a single
# manual run without switching it on globally.
MANAGER_HEARTBEAT_ENABLED=false

# Minutes between cycles when running scripts/heartbeat.py --watch, and the
# cadence to use if you register --once with your own scheduler. Nothing in
# this project schedules itself.
MANAGER_HEARTBEAT_INTERVAL_MINUTES=60

# How many messages one cycle may examine.
MANAGER_HEARTBEAT_FETCH_LIMIT=25

# Cross-run memory and reports. Both live under data/, which is gitignored.
MANAGER_STATE_PATH=data/state/processed.json
MANAGER_REPORTS_DIR=data/reports

# --- Agent identity and behaviour -----------------------------------------
# IDENTITY.md defines who the Manager is and which capabilities it handles
# itself; SOUL.md defines how it behaves. Both are committed. USER.md holds
# your personal profile and is gitignored.
MANAGER_IDENTITY_PATH=IDENTITY.md
MANAGER_SOUL_PATH=SOUL.md

# NOTE ON API KEYS
# ----------------
# The application does not read an API key and does not require one.
# A Claude Pro / Claude Code subscription is NOT an API key - it covers the
# development assistant, not programmatic API access. If a real provider is
# added later, its key would be read from the environment and must never be
# committed to this file.
